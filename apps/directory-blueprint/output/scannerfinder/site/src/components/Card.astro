---
// Listing card (data-* feed the region page's live filters and map): logo (when one was found), H3 name (link), stars + count, city, 3 attribute chips, phone, featured mark.
import Rating from './Rating.astro';
import { topAttrs, formatPhone, telHref, isFeaturedIn } from '../lib/load.mjs';
const { l, citySlug, town } = Astro.props;
const featured = isFeaturedIn(l, citySlug || l.citySlug);
const mark = featured ? 'Featured' : l.bestOfRank ? `Best of ${l.city} #${l.bestOfRank}` : l.premium ? 'Premium listing' : '';
const chips = topAttrs(l);
// No logo found: two initials in the same tile, so every card's name starts at the same place.
const initials = l.name.replace(/[^\p{L}\p{N} ]/gu, '').split(/\s+/).filter((w) => w && !/^(the|and|of|llc|ltd|inc)$/i.test(w)).slice(0, 2).map((w) => w[0].toUpperCase()).join('');
---
<article class="card" data-attrs={l.attrs.filter((a) => a.value === 'true').map((a) => a.key).join(' ')} data-rating={l.reviews ? l.rating : 0} data-reviews={l.reviews} data-town={town || l.city} data-lat={l.lat || undefined} data-lng={l.lng || undefined} data-name={l.name} data-path={l.path}>
  {mark && <span class="mark">{mark}</span>}
  <div class="card-head">
    {l.logo ? <img class="logo-mark" src={l.logo} alt="" width="48" height="48" loading="lazy" decoding="async" /> : <span class="logo-mark mono" aria-hidden="true">{initials}</span>}
    <h3><a href={l.path}>{l.name}</a></h3>
  </div>
  <Rating rating={l.rating} reviews={l.reviews} />
  <p class="meta">{l.areaService ? `Serves ${l.city}` : `${l.street || l.address}, ${l.city}`}{l.foldedFrom && l.foldedFrom !== l.city ? ` (based in ${l.foldedFrom})` : ''}</p>
  {chips.length > 0 && <ul class="chips">{chips.map((a) => <li>{a.label}</li>)}</ul>}
  {l.phone && <a class="phone" href={telHref(l.phone)}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>{formatPhone(l.phone)}</a>}
</article>
