---
const { site, listing } = Astro.props;
const href = listing ? `/claim/?listing=${encodeURIComponent(listing.slug)}&business=${encodeURIComponent(listing.name)}` : '/claim/';
---
<aside class="cta-band">
  <div>
    <h2>{listing ? 'Is this your business?' : 'Do you offer bioresonance or scan sessions?'}</h2>
    <p>{listing ? 'Claim the listing to correct details, add photos and hear about featured placement in your city.' : 'Claim your free listing, or get featured at the top of your city page.'}</p>
  </div>
  <div><a class="btn" href={href} rel={listing ? 'nofollow' : undefined}>{listing ? 'Claim this listing' : 'Claim your listing'}</a> &nbsp; <a href="/featured/" style="color:inherit">Get featured</a></div>
</aside>
