---
// About: the publisher front and center (wiki/framework/publisher-entity.md). Publisher schema: Organization (DGA) since 2026-10-13.
import Base from '../layouts/Base.astro';
import { loadDirectory } from '../lib/load.mjs';
import { paragraphs } from '../lib/load.mjs';
const { site, listings, indexCities: cities, buildDate } = loadDirectory();
const vetting = site.vetting && site.vetting.length ? site.vetting : null;
const p = site.publisher;
const base = `https://${site.domain}`;
const title = `About ${site.brand}`;
const description = `${site.brand} is published by ${p.name}. Why it exists, how listings are vetted, and how to reach us.`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'AboutPage', '@id': base + '/about/', url: base + '/about/', name: title, datePublished: site.launchDate, dateModified: buildDate, mainEntity: { '@id': `${base}/#person` } },
  { '@context': 'https://schema.org', '@type': p.type || 'Person', '@id': `${base}/#person`, name: p.name, legalName: p.legalName || undefined, url: p.url || undefined, email: p.email || undefined,
    [p.type === 'Organization' ? 'logo' : 'image']: p.image ? base + p.image : undefined, description: p.bio, sameAs: (p.sameAs || []).filter(Boolean), owns: { '@type': 'Organization', '@id': `${base}/#publisher`, name: site.brand, url: base + '/' } },
];
---
<Base title={title} description={description} path="/about/" schema={schema}>
  <Fragment slot="head">
    <h1>About {site.brand}</h1>
  </Fragment>
  <div class="publisher">
    {p.image && <a href={p.url} rel="noopener" target="_blank"><img src={p.image} alt={`${p.legalName || p.name} logo`} width="160" height="141" /></a>}
    <div class="prose">
      <h2 style="margin-top:0">Published by <a href={p.url} rel="noopener" target="_blank">{p.name}</a></h2>
      <p>{p.bio}</p>
      {p.url && <p><a href={p.url} rel="noopener" target="_blank">{p.url.replace(/^https?:\/\//, '')}</a></p>}
    </div>
  </div>
  {p.videoEmbed && <div class="prose" set:html={p.videoEmbed}></div>}
  <section class="prose">
    <h2>Why this directory exists</h2>
    <p>We started ScannerFinder because finding a practitioner who offers a bioresonance or biofeedback session was harder than it should be. The information sat on Facebook pages, booking widgets and distributor sites, and many of the names that came up were people selling the devices, not people offering sessions.</p>
    <p>So the directory works from the device outwards. Each practitioner here was found by the name of the device they use, then checked against their own website. Device sellers, training schools and network marketing pages are left out. Where a practitioner names the device, the listing says so; where they offer remote sessions or sessions for animals, the listing says that too. Where the website says nothing, the listing says "not enough info" instead of guessing.</p>
    <p>Two things ScannerFinder does not do. It does not publish a session price until the practitioner confirms it, because prices on old web pages are often out of date. And it does not describe any scan as a medical test. These are wellness sessions, and the copy on every page is written that way.</p>
    <p>If you run one of the practices listed here, you can claim your listing for free and correct anything that is wrong.</p>
    <h2>How listings are vetted</h2>
    {vetting
      ? <div set:html={paragraphs(vetting.slice(0, 2))}></div>
      : <p>Every listing starts from public business records and Google Maps, found by device brand. We keep practitioners who offer scan sessions to clients, leave out device sellers, training schools and network marketing pages, and merge duplicates.</p>}
    <p>Right now that is {listings.length.toLocaleString('en-US')} {site.niche.plural} in {cities.length} regions of nine countries, last refreshed {buildDate}.</p>
    <p>Owners can claim their listing for free. Every claim is checked by a person: a real local business, a matching email domain or a call to the number on the Google listing. Paid placements are marked as featured, premium or best-of wherever they appear.</p>
    <h2>Corrections and removals</h2>
    <p>If a listing is wrong, or you want your business removed, <a href="/contact/">tell us</a>. We answer within a week and rebuild the directory with the change.</p>
  </section>
</Base>
