---
// Blog article (2026-10-13, layout from mypeptidematch.com/blog/<post>): breadcrumbs, category, H1, tags,
// author/date/read time + share, then the article with Key Takeaways, the body, Related Tools, a
// find-a-practitioner CTA and the FAQ (visible text, no accordion), beside a sticky "On this page" list.
// "Continue reading" closes with three more posts. Placeholder posts are noindex.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { loadDirectory } from '../../lib/load.mjs';
import { loadPosts, formatDate } from '../../lib/blog.mjs';
import tools from '../../data/tools.json';
export function getStaticPaths() {
  return loadPosts().map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const { slug } = Astro.props;
const { site } = loadDirectory();
const posts = loadPosts();
const post = posts.find((p) => p.slug === slug);
const { Content } = post;
const base = `https://${site.domain}`;
const url = base + post.path;
const toc = post.headings.filter((h) => h.depth <= 3);
const more = [...posts.filter((p) => p !== post && p.category === post.category), ...posts.filter((p) => p !== post && p.category !== post.category)].slice(0, 3);
const initials = post.author.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).slice(0, 2).map((w) => w[0]).join('');
const schema = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.description, url, mainEntityOfPage: url,
    datePublished: post.published, dateModified: post.updated, author: { '@type': 'Organization', name: post.author },
    publisher: { '@id': `${base}/#publisher` }, keywords: post.tags.join(', '), image: post.image ? base + post.image : undefined },
  ...(post.faqs.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: post.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
const share = [
  ['X', `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(post.title)}`],
  ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`],
  ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`],
];
---
<Base title={`${post.title} | ${site.brand}`} description={post.description} path={post.path} schema={schema} ogType="article" noindex={post.placeholder || post.draft}>
  <Fragment slot="head">
    <Breadcrumbs site={site} items={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: post.title, href: post.path }]} />
    <span class="post-cat">{post.category}</span>
    <h1 class="post-title">{post.title}</h1>
    {post.tags.length > 0 && <ul class="post-tags">{post.tags.map((t) => <li>{t}</li>)}</ul>}
    <div class="post-byline">
      <span class="avatar" aria-hidden="true">{initials}</span>
      <span><b>{post.author}</b><br /><span class="post-meta">{formatDate(post.published)} · {post.readMinutes} min read</span></span>
      <span class="post-share"><span>Share</span>{share.map(([n, h]) => <a href={h} target="_blank" rel="noopener" aria-label={`Share on ${n}`}>{n}</a>)}<button type="button" id="copy-link" data-url={url}>Copy link</button></span>
    </div>
  </Fragment>

  <div class="post-layout">
    <article class="post-body">
      {post.image && <img class="post-hero" src={post.image} alt="" />}
      {post.takeaways.length > 0 && (
        <section class="key-takeaways" id="key-takeaways">
          <h2>Key Takeaways</h2>
          <ul>{post.takeaways.map((t) => <li>{t}</li>)}</ul>
        </section>
      )}
      <div class="prose post-content"><Content /></div>

      {tools.length > 0 && (
        <section class="related-tools">
          <h3>Related Tools</h3>
          <ul>{tools.map((t) => <li><a href={t.path}><b>{t.title}</b><span>{t.description}</span></a></li>)}</ul>
        </section>
      )}

      <aside class="cta-band post-cta">
        <div>
          <h2>Find a practitioner near you</h2>
          <p>Search {site.niche.plural} by device and by region in {loadDirectory().countries.length} countries.</p>
        </div>
        <div><a class="btn" href="/search/">Find a practitioner</a></div>
      </aside>

      {post.faqs.length > 0 && (
        <section class="faq post-faq" id="frequently-asked-questions">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-grid">{post.faqs.map((f) => <div class="qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}</div>
        </section>
      )}
    </article>

    {toc.length > 0 && (
      <aside class="post-toc" aria-label="On this page">
        <h3>On this page</h3>
        <ol>
          {post.takeaways.length > 0 && <li><a href="#key-takeaways">Key Takeaways</a></li>}
          {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
          {post.faqs.length > 0 && <li><a href="#frequently-asked-questions">FAQ</a></li>}
        </ol>
      </aside>
    )}
  </div>

  {more.length > 0 && (
    <section class="post-more">
      <h2>Continue Reading</h2>
      <div class="post-grid three">
        {more.map((p) => (
          <a class="post-card" href={p.path}>
            <div class="pc-img">{p.image ? <img src={p.image} alt="" loading="lazy" /> : <span>{p.category}</span>}</div>
            <div class="pc-body">
              <span class="post-cat">{p.category}</span>
              <h3>{p.title}</h3>
              <span class="post-meta">{formatDate(p.published)} · {p.readMinutes} min read</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<script is:inline>
(function () {
  var b = document.getElementById('copy-link'); if (!b) return;
  b.addEventListener('click', function () {
    try { navigator.clipboard.writeText(b.dataset.url); b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy link'; }, 1600); } catch (e) {}
  });
  // Highlight the section being read in "On this page".
  var links = Array.prototype.slice.call(document.querySelectorAll('.post-toc a'));
  if (!('IntersectionObserver' in window) || !links.length) return;
  var byId = {}; links.forEach(function (a) { byId[a.getAttribute('href').slice(1)] = a; });
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting && byId[e.target.id]) { links.forEach(function (a) { a.classList.remove('on'); }); byId[e.target.id].classList.add('on'); } });
  }, { rootMargin: '0px 0px -70% 0px' });
  Object.keys(byId).forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
})();
</script>
