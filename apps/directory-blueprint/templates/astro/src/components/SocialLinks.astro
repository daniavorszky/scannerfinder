const items = socials.filter((s) => ICON[s.network]);
---
{items.length > 0 && (
  <span class="socials">
    {items.map((s) => (
      <a href={s.url} rel={followed ? 'noopener' : 'nofollow noopener'} target="_blank" title={`${name} on ${ICON[s.network][0]}`}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={ICON[s.network][1]} fill="currentColor" /></svg>
        <span class="sr-only">{ICON[s.network][0]}</span>
      </a>
    ))}
  </span>
)}
